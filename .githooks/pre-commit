#!/usr/bin/env bash
set -e

# ==============================================================================
# OpenLocalCRM Enterprise Pre-Commit Hook
# Multi-stage security, quality, compliance & static analysis verification
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BLUE}${BOLD}🔍 [Pre-Commit] Starte Enterprise-Qualitätsprüfungen...${NC}"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ Keine gestagten Dateien gefunden.${NC}"
    exit 0
fi

# ------------------------------------------------------------------------------
# 1. Security & Secret Leak Prevention
# ------------------------------------------------------------------------------
echo -n "  [1/5] Prüfe auf Sicherheitsleaks & versehentlich gestagte Secrets... "

# 1a. Prohibited filenames
FORBIDDEN_FILES=$(echo "$STAGED_FILES" | grep -E '^(\.env(\.[^e].*|\.[a-z0-9]+)?|\.env\.local|\.env\.production|.*\.key|.*\.pem|.*\.pfx|.*\.crt|.*\.p12|.*\.dump|backups/.*\.sql)$' | grep -v '\.env\.example' || true)

if [ -n "$FORBIDDEN_FILES" ]; then
    echo -e "${RED}FEHLER${NC}"
    echo -e "${RED}${BOLD}❌ Sicherheitsrisiko:${NC} Folgende vertrauliche Dateien dürfen nicht committet werden:"
    echo "$FORBIDDEN_FILES" | while read -r f; do echo -e "   ${RED}• $f${NC}"; done
    echo -e "${YELLOW}Tipp: Entfernen Sie die Dateien mit 'git reset HEAD <datei>' aus dem Staging-Bereich.${NC}"
    exit 1
fi

# 1b. Inspect diff content for leaked credentials / private keys
SECRET_DIFF=$(git diff --cached --no-color -U0 | grep -E '^\+[ ]*(-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{30,}|re_[a-zA-Z0-9]{20,})' || true)

if [ -n "$SECRET_DIFF" ]; then
    echo -e "${RED}FEHLER${NC}"
    echo -e "${RED}${BOLD}❌ Sicherheitsrisiko:${NC} Potenzieller API-Schlüssel oder privater Key im Diff gefunden!"
    echo -e "${RED}$SECRET_DIFF${NC}"
    exit 1
fi

echo -e "${GREEN}OK${NC}"

# ------------------------------------------------------------------------------
# 2. Go Format & Static Analysis (gofmt & go vet)
# ------------------------------------------------------------------------------
STAGED_GO_FILES=$(echo "$STAGED_FILES" | grep -E '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo -n "  [2/5] Prüfe Go Code-Formatierung (gofmt)... "
    UNFORMATTED_GO=$(gofmt -s -l $STAGED_GO_FILES || true)
    if [ -n "$UNFORMATTED_GO" ]; then
        echo -e "${RED}FEHLER${NC}"
        echo -e "${RED}❌ Folgende Go-Dateien entsprechen nicht dem Standard-Format:${NC}"
        echo "$UNFORMATTED_GO" | while read -r f; do echo -e "   ${RED}• $f${NC}"; done
        echo -e "${YELLOW}Tipp: Führen Sie 'make fmt' oder 'gofmt -s -w .' aus und stagen Sie die Änderungen.${NC}"
        exit 1
    fi
    echo -e "${GREEN}OK${NC}"

    echo -n "  [3/5] Führe statische Go-Analyse aus (go vet)... "
    if ! go vet ./... 2>&1; then
        echo -e "${RED}FEHLER${NC}"
        echo -e "${RED}❌ 'go vet' hat statische Codefehler gefunden. Bitte vor dem Commit beheben.${NC}"
        exit 1
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo "  [2/5] Keine Go-Dateien geändert — überspringe gofmt."
    echo "  [3/5] Keine Go-Dateien geändert — überspringe go vet."
fi

# ------------------------------------------------------------------------------
# 3. Frontend Linting & Typecheck (TypeScript & ESLint)
# ------------------------------------------------------------------------------
STAGED_WEB_FILES=$(echo "$STAGED_FILES" | grep -E '^web/' || true)

if [ -n "$STAGED_WEB_FILES" ]; then
    echo -n "  [4/5] Prüfe Web Frontend (TypeScript Typecheck & ESLint)... "
    if [ -d "web" ]; then
        if ! (cd web && pnpm typecheck > /dev/null 2>&1); then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ TypeScript Typecheck im Frontend fehlgeschlagen!${NC}"
            echo -e "${YELLOW}Führen Sie 'cd web && pnpm typecheck' aus, um Details zu sehen.${NC}"
            exit 1
        fi

        if ! (cd web && pnpm lint > /dev/null 2>&1); then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ ESLint-Prüfung im Frontend fehlgeschlagen!${NC}"
            echo -e "${YELLOW}Führen Sie 'cd web && pnpm lint' aus, um Details zu sehen.${NC}"
            exit 1
        fi
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo "  [4/5] Keine Frontend-Dateien geändert — überspringe Typecheck & Lint."
fi

# ------------------------------------------------------------------------------
# 4. Open-Source License Audit & Migrations
# ------------------------------------------------------------------------------
STAGED_MOD_FILES=$(echo "$STAGED_FILES" | grep -E '^(go\.mod|go\.sum)$' || true)

if [ -n "$STAGED_MOD_FILES" ]; then
    echo -n "  [5/5] Neue Go-Dependencies erkannt: Prüfe Lizenz-Compliance... "
    if [ -f "./scripts/check-licenses.sh" ]; then
        if ! ./scripts/check-licenses.sh > /dev/null 2>&1; then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ Lizenz-Audit fehlgeschlagen: Nicht-konforme Abhängigkeit erkannt!${NC}"
            exit 1
        fi
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo "  [5/5] Keine neuen Go-Dependencies gestagt — überspringe Lizenz-Scan."
fi

echo -e "${GREEN}${BOLD}✅ Alle Pre-Commit-Prüfungen erfolgreich bestanden!${NC}"
exit 0
