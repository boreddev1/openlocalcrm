#!/usr/bin/env bash
set -e

# ==============================================================================
# OpenLocalCRM Enterprise Robust Pre-Commit Hook
# Handles GUI git clients, cross-platform paths, secret leakage, migration sync,
# typecheck, linting, and licensing compliance.
# ==============================================================================

# Ensure standard developer paths are available even in GUI Git clients (macOS/Linux)
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$HOME/go/bin:/usr/local/go/bin:$HOME/Library/pnpm:$HOME/.local/share/pnpm:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -n 1)/bin:$HOME/.cargo/bin:$PATH"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BLUE}${BOLD}🔍 [Pre-Commit] Starte Enterprise-Qualitätsprüfungen...${NC}"

# Get list of staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ Keine gestagten Dateien gefunden.${NC}"
    exit 0
fi

# ------------------------------------------------------------------------------
# 1. Security & Secret Leak Prevention
# ------------------------------------------------------------------------------
echo -n "  [1/7] Prüfe auf Sicherheitsleaks & vertrauliche Daten... "

# 1a. Prohibited filenames (allow only .env.example)
FORBIDDEN_FILES=$(echo "$STAGED_FILES" | grep -E '^(\.env(\.[^e].*|\.[a-z0-9]+)?|\.env\.local|\.env\.production|.*\.key|.*\.pem|.*\.pfx|.*\.crt|.*\.p12|.*\.dump|backups/.*\.sql|data/storage/.*\.key)$' | grep -v '\.env\.example' || true)

if [ -n "$FORBIDDEN_FILES" ]; then
    echo -e "${RED}FEHLER${NC}"
    echo -e "${RED}${BOLD}❌ Sicherheitsrisiko:${NC} Folgende vertrauliche Dateien dürfen nicht committet werden:"
    echo "$FORBIDDEN_FILES" | while read -r f; do echo -e "   ${RED}• $f${NC}"; done
    echo -e "${YELLOW}Tipp: Entfernen Sie die Dateien mit 'git reset HEAD <datei>' aus dem Staging-Bereich.${NC}"
    exit 1
fi

# 1b. Inspect diff content for leaked credentials / private keys (ignoring tests/mocks)
STAGED_NON_TEST=$(echo "$STAGED_FILES" | grep -v -E '(_test\.go|\.spec\.ts|\.test\.ts|\.example)' || true)
if [ -n "$STAGED_NON_TEST" ]; then
    SECRET_DIFF=$(git diff --cached --no-color -U0 -- $STAGED_NON_TEST | grep -E '^\+[ ]*(-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|sk-proj-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{30,}|re_[a-zA-Z0-9]{20,})' || true)

    if [ -n "$SECRET_DIFF" ]; then
        echo -e "${RED}FEHLER${NC}"
        echo -e "${RED}${BOLD}❌ Sicherheitsrisiko:${NC} Potenzieller API-Schlüssel oder privater Key im Diff gefunden!"
        echo -e "${RED}$SECRET_DIFF${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}OK${NC}"

# ------------------------------------------------------------------------------
# 2. Database Migration & SQLC Synchronisation Integrity
# ------------------------------------------------------------------------------
echo -n "  [2/7] Prüfe Datenbank-Migrationen & SQLC-Konsistenz... "

# Verify migrations sync between migrations/ and internal/db/migrations/
MIG_ROOT=$(ls migrations/*.sql 2>/dev/null | xargs -n 1 basename | sort || true)
MIG_INT=$(ls internal/db/migrations/*.sql 2>/dev/null | xargs -n 1 basename | sort || true)

if [ "$MIG_ROOT" != "$MIG_INT" ]; then
    echo -e "${RED}FEHLER${NC}"
    echo -e "${RED}❌ Inkonsistenz erkannt:${NC} 'migrations/' und 'internal/db/migrations/' stimmen nicht überein!"
    echo -e "${YELLOW}Das Go-Binary bettet 'internal/db/migrations/' ein. Beide Verzeichnisse müssen identisch sein.${NC}"
    exit 1
fi

# If SQL queries in internal/db/queries/ changed, check if generated Go code was updated
STAGED_SQL_QUERIES=$(echo "$STAGED_FILES" | grep -E '^internal/db/queries/' || true)
if [ -n "$STAGED_SQL_QUERIES" ]; then
    STAGED_SQL_GEN=$(echo "$STAGED_FILES" | grep -E '^internal/db/.*\.sql\.go$' || true)
    if [ -z "$STAGED_SQL_GEN" ]; then
        echo -e "${RED}FEHLER${NC}"
        echo -e "${RED}❌ 'internal/db/queries/*.sql' wurde geändert, aber keine generierten '*.sql.go'-Dateien gestagt!${NC}"
        echo -e "${YELLOW}Tipp: Führen Sie 'sqlc generate' aus und stagen Sie die generierten Go-Dateien.${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}OK${NC}"

# ------------------------------------------------------------------------------
# 3. Go Code-Formatierung (gofmt)
# ------------------------------------------------------------------------------
STAGED_GO_FILES=$(echo "$STAGED_FILES" | grep -E '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo -n "  [3/7] Prüfe Go Code-Formatierung (gofmt)... "
    if ! command -v gofmt >/dev/null 2>&1; then
        echo -e "${YELLOW}WARNUNG (gofmt nicht im PATH)${NC}"
    else
        UNFORMATTED_GO=$(gofmt -s -l $STAGED_GO_FILES 2>/dev/null || true)
        if [ -n "$UNFORMATTED_GO" ]; then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ Folgende Go-Dateien entsprechen nicht dem Standard-Format:${NC}"
            echo "$UNFORMATTED_GO" | while read -r f; do echo -e "   ${RED}• $f${NC}"; done
            echo -e "${YELLOW}Tipp: Führen Sie 'make fmt' oder 'gofmt -s -w .' aus und stagen Sie die Änderungen.${NC}"
            exit 1
        fi
        echo -e "${GREEN}OK${NC}"
    fi

    echo -n "  [4/7] Führe statische Go-Analyse aus (go vet)... "
    if ! command -v go >/dev/null 2>&1; then
        echo -e "${YELLOW}WARNUNG (go nicht im PATH)${NC}"
    else
        if ! go vet ./... >/dev/null 2>&1; then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ 'go vet' hat statische Codefehler gefunden. Führen Sie 'go vet ./...' zur Diagnose aus.${NC}"
            exit 1
        fi
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo "  [3/7] Keine Go-Dateien geändert — überspringe gofmt."
    echo "  [4/7] Keine Go-Dateien geändert — überspringe go vet."
fi

# ------------------------------------------------------------------------------
# 4. Frontend Linting & Typecheck (TypeScript & ESLint)
# ------------------------------------------------------------------------------
STAGED_WEB_FILES=$(echo "$STAGED_FILES" | grep -E '^web/' || true)

if [ -n "$STAGED_WEB_FILES" ]; then
    echo -n "  [5/7] Prüfe Web Frontend (TypeScript Typecheck & ESLint)... "
    if ! command -v pnpm >/dev/null 2>&1; then
        echo -e "${YELLOW}WARNUNG (pnpm nicht im PATH)${NC}"
    else
        if [ -d "web" ]; then
            if ! (cd web && pnpm typecheck > /dev/null 2>&1); then
                echo -e "${RED}FEHLER${NC}"
                echo -e "${RED}❌ TypeScript Typecheck im Frontend fehlgeschlagen!${NC}"
                echo -e "${YELLOW}Führen Sie 'cd web && pnpm typecheck' aus, um Details zu sehen.${NC}"
                exit 1
            fi

            if ! (cd web && pnpm lint > /dev/null 2>&1); then
                echo -e "${RED}FEHLER${NC}"
                echo -e "${RED}❌ ESLint-Prüfung im Frontend fehlgeschlagen!${NC}"
                echo -e "${YELLOW}Führen Sie 'cd web && pnpm lint' aus, um Details zu sehen.${NC}"
                exit 1
            fi
        fi
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo "  [5/7] Keine Frontend-Dateien geändert — überspringe Typecheck & Lint."
fi

# ------------------------------------------------------------------------------
# 5. Web dist Freshness (Invariant #5: committed web/dist == fresh build of web/src)
# Only pays the ~2-3 s vite build when staged files can change the bundle.
# ------------------------------------------------------------------------------
STAGED_WEB_INPUTS=$(echo "$STAGED_FILES" | grep -E '^web/(src/|index\.html|vite\.config\.ts|tsconfig[^/]*\.json|tailwind\.config\.|postcss\.config\.|package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml)' || true)

if [ -n "$STAGED_WEB_INPUTS" ]; then
    echo -n "  [6/7] Prüfe web/dist-Freshness (frischer Build vs. gestagter dist)..."
    if ! command -v pnpm >/dev/null 2>&1; then
        echo -e "${YELLOW}WARNUNG (pnpm nicht im PATH)${NC}"
    else
        TMP_DIST=$(mktemp -d)
        trap 'rm -rf "$TMP_DIST"' EXIT
        if ! (cd web && pnpm exec vite build --outDir "$TMP_DIST/dist" --emptyOutDir > /dev/null 2>&1); then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ 'vite build' fehlgeschlagen — web/dist-Freshheit nicht prüfbar!${NC}"
            echo -e "${YELLOW}Tipp: 'cd web && pnpm install --frozen-lockfile && pnpm build' ausführen, um Fehler zu sehen.${NC}"
            exit 1
        fi
        mkdir -p "$TMP_DIST/staged"
        git ls-files --cached -- web/dist | git checkout-index --stdin --prefix="$TMP_DIST/staged/" 2>/dev/null || true
        DIST_DIFF=$(diff -rq "$TMP_DIST/dist" "$TMP_DIST/staged/web/dist" 2>&1 || true)
        rm -rf "$TMP_DIST"
        if [ -n "$DIST_DIFF" ]; then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ web/dist ist veraltet: ein frischer Build erzeugt anderen Output als der gestagte web/dist (Invariant #5).${NC}"
            echo -e "${RED}Ursache: Gestagte Web-Build-Inputs ohne passenden dist-Rebuild:${NC}"
            echo "$STAGED_WEB_INPUTS" | head -10 | while read -r f; do echo -e "   ${RED}• $f${NC}"; done
            echo "$DIST_DIFF" | head -15 | sed 's/^/   /'
            echo -e "${YELLOW}Tipp: 'cd web && pnpm build' ausführen und das Ergebnis staggen: git add -A web/dist${NC}"
            exit 1
        fi
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo "  [6/7] Keine Web-Build-Inputs geändert — überspringe dist-Freshness-Check."
fi

# ------------------------------------------------------------------------------
# 6. Open-Source License Audit
# ------------------------------------------------------------------------------
STAGED_MOD_FILES=$(echo "$STAGED_FILES" | grep -E '^(go\.mod|go\.sum)$' || true)

if [ -n "$STAGED_MOD_FILES" ]; then
    echo -n "  [7/7] Neue Go-Dependencies erkannt: Prüfe Lizenz-Compliance... "
    if [ -f "./scripts/check-licenses.sh" ]; then
        if ! ./scripts/check-licenses.sh > /dev/null 2>&1; then
            echo -e "${RED}FEHLER${NC}"
            echo -e "${RED}❌ Lizenz-Audit fehlgeschlagen: Nicht-konforme Abhängigkeit erkannt!${NC}"
            exit 1
        fi
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo "  [7/7] Keine neuen Go-Dependencies gestagt — überspringe Lizenz-Scan."
fi

echo -e "${GREEN}${BOLD}✅ Alle Pre-Commit-Prüfungen erfolgreich bestanden!${NC}"
exit 0
