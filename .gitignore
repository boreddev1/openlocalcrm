# Binaries and build artifacts
/bin/
bin/
# Root build artifact (stray `go build` output), anchored so the internal/server/ package is not matched.
/server
/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.log

# Test artifacts
coverage/
coverage.out
coverage.html
test-results/
playwright-report/
playwright/.auth/
web/playwright/

# Dependencies
node_modules/
# A trailing-slash pattern only matches directories, so a root-level node_modules
# that is a symlink or a file stays visible to git. Anchor it at the root as well.
/node_modules
/vendor/

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Root Data & storage directories
/data/
/storage/
/backups/
user-errors/
*.db
*.sqlite
*.sql
!internal/db/migrations/*.sql
!internal/db/queries/*.sql
!migrations/*.sql

# OS and Editor files
.DS_Store
.idea/
.vscode/
*.swp
*.png

# Agent session state (Claude Code & co.): local settings, task locks and the
# isolated checkouts under .claude/worktrees/ — those are full working copies
# (hundreds of MB) and never source. Nothing under .claude/ is tracked, and
# nothing is allowlisted on purpose: even a "shared" settings.json can carry
# secrets through its env / apiKeyHelper entries.
.claude/
# A trailing-slash pattern only matches directories, so a root-level .claude
# that is a symlink or a file stays visible to git. Anchor it at the root as well.
/.claude

# Superpowers and Planning Artifacts
.superpowers/
docs/superpowers/
