# ==========================================
# Multi-Stage Production Dockerfile for OpenLocalCRM
# ==========================================

# Stage 1: Build React SPA Frontend
FROM node:22-alpine AS web-builder
WORKDIR /app/web
# pnpm 12.4.1: the audit `overrides` live in web/pnpm-workspace.yaml, and pnpm 9 reads them
# neither from that file nor from the lockfile `settings` they record there (measured:
# pnpm 9.15.9 fails this frozen install with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH, 12.4.1 passes).
# Keep this version in sync with ci.yml, docker-publish.yml and CONTRIBUTING.md.
RUN npm install -g pnpm@12.4.1
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

# Stage 2: Compile Single-Tenant Go Server Binary
FROM golang:alpine AS go-builder
ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Overwrite/ensure pre-built embedded assets from web-builder
COPY --from=web-builder /app/web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/crm-server ./cmd/server

# Stage 3: Minimal Secure Production Container
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 10001 -S crmuser && \
    adduser -u 10001 -S crmuser -G crmuser

WORKDIR /app
COPY --from=go-builder /bin/crm-server /app/crm-server

# Create and grant permissions for storage and keys
RUN mkdir -p /data/storage /app/keys && \
    chown -R crmuser:crmuser /data/storage /app/keys /app

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["/app/crm-server"]
