# ==============================================================================
# OpenLocalCRM - Environment Configuration Example (.env.example)
# Copy this file to .env and customize values for production deployment.
# ==============================================================================

# General
DOMAIN=localhost
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL 16)
DB_HOST=crm-db
DB_PORT=5432
DB_NAME=openlocalcrm
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgres://postgres:your_secure_postgres_password_here@crm-db:5432/openlocalcrm?sslmode=disable

# Authentication & JWT (Ed25519)
# Generate Ed25519 keypair: openssl genpkey -algorithm ed25519 -out jwt_private.key
JWT_PRIVATE_KEY_PATH=/etc/openlocalcrm/jwt_private.key
JWT_PUBLIC_KEY_PATH=/etc/openlocalcrm/jwt_public.key

# Storage
STORAGE_LOCAL_DIR=/storage

# Connectors
CONNECTOR_API_TOKEN=your_secure_connector_token_here

# AI Gateway (Local Ollama or External LLM)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b

