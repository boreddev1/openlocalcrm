# ==============================================================================
# OpenLocalCRM - Environment Configuration Example (.env.example)
# Copy this file to .env and customize values for production deployment.
# ==============================================================================

# General
DOMAIN=localhost
PORT=8080
LOG_LEVEL=info
DEMO_MODE=false

# Initial Admin Setup
INITIAL_ADMIN_EMAIL=admin@openlocalcrm.local
INITIAL_ADMIN_PASSWORD=change_this_secure_admin_password_123!
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User

# Database (PostgreSQL 16)
DB_HOST=crm-db
DB_PORT=5432
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgres://crm_user:your_secure_postgres_password_here@crm-db:5432/crm_db?sslmode=disable

# Authentication & JWT (Ed25519)
# Canonical key path (fallback alias: JWT_PRIVATE_KEY_PATH)
JWT_SECRET_KEY_PATH=/app/keys/ed25519.key
FORCE_SECURE_COOKIES=false

# Storage
# Canonical storage directory (fallback alias: STORAGE_LOCAL_DIR)
STORAGE_PATH=/data/storage

# Connectors
CONNECTOR_API_TOKEN=your_secure_connector_token_here

# AI Gateway (Local Ollama or External LLM)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
# Embedding model: AI_EMBEDDING_MODEL wins over OLLAMA_EMBEDDING_MODEL.
# OpenAI-compatible providers (openai/mistral/nebius) require an explicit model.
AI_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_API_KEY=
AI_BASE_URL=


